# Copy to secrets.toml for local Streamlit (do not commit secrets.toml).
# On Streamlit Community Cloud: paste equivalent keys in App Settings → Secrets.

LLM_API_KEY = "gsk_your_groq_key_here"
DATA_PATH = "data/processed/restaurants.parquet"
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_PROVIDER = "groq"
BUDGET_LOW_MAX = 500
BUDGET_MEDIUM_MAX = 1500
MAX_CANDIDATES = 30
