# Data (resolved from repo root; see src/app/config.py)
DATA_PATH=data/processed/restaurants.parquet

# --- Railway (backend) ---
# Do not set on Railway unless you intend to download ~574MB from Hugging Face at boot
# ALLOW_HF_INGEST=0

# Comma-separated Vercel frontend URLs (production + optional named previews)
# CORS_ORIGINS=https://zomatomilestone.vercel.app
# Allow all *.vercel.app preview deploys (default: true)
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Local API hot reload (optional)
# API_RELOAD=1

# --- Vercel (frontend) — set in Vercel dashboard, not here ---
# VITE_API_URL=https://your-service.up.railway.app

# --- Streamlit Cloud — see .streamlit/secrets.toml.example ---

# Budget bands (INR, cost for two)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Filtering / LLM
MAX_CANDIDATES=30
LOCATION_MATCH_MODE=substring
MAX_ADDITIONAL_PREFERENCES_LENGTH=500

# LLM — Groq (https://console.groq.com/)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
GROQ_BASE_URL=https://api.groq.com
