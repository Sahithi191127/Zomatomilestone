# Data (resolved from repo root; see src/app/config.py)
DATA_PATH=data/processed/restaurants.parquet

# Streamlit Cloud: use App Settings → Secrets (see .streamlit/secrets.toml.example)

# Railway (FastAPI) — comma-separated Vercel / frontend origins
# CORS_ORIGINS=https://tastepilot.vercel.app,https://tastepilot-git-main-yourteam.vercel.app

# Local API hot reload (optional)
# API_RELOAD=1

# Budget bands (INR, cost for two) — Data Architecture defaults
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Filtering / LLM (later phases)
MAX_CANDIDATES=30
LOCATION_MATCH_MODE=substring
MAX_ADDITIONAL_PREFERENCES_LENGTH=500

# LLM (Phase 4+) — Groq milestone provider (https://console.groq.com/)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
GROQ_BASE_URL=https://api.groq.com
